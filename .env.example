# Add these as GitHub Actions Secrets (never commit real values)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

BUFFER_API_KEY=
# BUFFER_CHANNEL_ID is a GitHub Actions repository VARIABLE, not a secret.
BUFFER_CHANNEL_ID=
BUFFER_EXPECTED_CHANNEL_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pakistani-drama-clips

# One scheduled run queues one Reel. The workflow runs 5 times daily.
CLIP_SECONDS=85
