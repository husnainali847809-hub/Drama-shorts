# OpenRouter free-model access (add as a GitHub Actions secret for cloud runs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HINDI_TTS_VOICE=hi-IN-SwaraNeural

# Existing Buffer connection for the Animated Jungle Facebook Page
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
BUFFER_EXPECTED_CHANNEL_NAME=Animated Jungle

# Existing Cloudinary connection
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mixed-content-factory

# Reel output
CLIP_MIN_SECONDS=85
CLIP_MAX_SECONDS=89
OUTPUT_DIR=output
